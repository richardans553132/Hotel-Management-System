{
    "name": "yourname/hotel-booking",
    "description": "Smart Hotel Booking Management System",
    "type": "project",
    "require": {
        "php": "^7.4 || ^8.0",
        "phpmailer/phpmailer": "^6.9",
        "paystack/paystack-php": "^1.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-install-cmd": "php -r \"if (!file_exists('.env')) copy('.env.example', '.env');\""
    }
}

